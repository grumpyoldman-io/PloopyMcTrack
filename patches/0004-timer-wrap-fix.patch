+/* Elapsed time that tolerates a start time slightly in the future.
+ * This file marks "timer running" by storing timer_read32() | 1, so a
+ * stored time can be 1 ms ahead of the clock; plain timer_elapsed32()
+ * then wraps to ~49 days whenever it is checked in the same millisecond,
+ * and every "held longer than X" test passes at once. Measured effect:
+ * double taps turned into tap-and-drag on the second touch's first
+ * report. Treat any negative interval as zero. */
+static inline uint32_t fb_elapsed32(uint32_t t) {
+    const uint32_t e = timer_read32() - t;
+    return e > 0x80000000u ? 0 : e;
